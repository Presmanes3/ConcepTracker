# -- Database -----------------------------------------------------------------
# PostgreSQL connection string (required).
# The Docker Compose service binds to port 5432 by default.
DATABASE_URL=postgresql://user:password@localhost:5432/conceptracker

# -- AWS credentials ----------------------------------------------------------
# Provide either key/secret pair OR a named profile — not both.

AWS_REGION=eu-west-1

# Option A: explicit credentials (CI, containers, users without ~/.aws/config)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Option B: named profile from ~/.aws/config (local development)
# AWS_PROFILE=default
